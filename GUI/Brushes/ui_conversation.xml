<Brushes>

 <Brush Name="ConversationItemBrush">
    <Layers>
      <BrushLayer Name="Default" Sprite="dialog_option_canvas_9" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" AlphaFactor="0.85" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" AlphaFactor="0.8" HueFactor="40" SaturationFactor="80" ValueFactor="15" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" AlphaFactor="1.0" HueFactor="40" SaturationFactor="80" ValueFactor="10" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" AlphaFactor="0.4" />
      </Style>
    </Styles>
    <SoundProperties>
      <StateSounds>
      </StateSounds>
      <EventSounds>
        <EventSound EventName="Click" Audio="conversation" />
      </EventSounds>
    </SoundProperties>
  </Brush>

<!--changed size-->

	<Brush Name="Conversation.HeaderText" Font="Galahad">
		<Styles>
			<Style Name="Default" FontColor="#E2AF54FF" TextGlowColor="#000000FF" TextOutlineColor="#000000FF" TextOutlineAmount="0.1" TextGlowRadius="0.3" TextBlur="0.3" FontSize="50"/>
			<Style Name="Hovered" FontColor="#E2AF54FF" TextGlowColor="#000000FF" TextOutlineColor="#000000FF" TextOutlineAmount="0.1" TextGlowRadius="0.3" TextBlur="0.3" FontSize="50" TextColorFactor="1.2"/>
			<Style Name="Pressed" FontColor="#E2AF54FF" TextGlowColor="#000000FF" TextOutlineColor="#000000FF" TextOutlineAmount="0.1" TextGlowRadius="0.3" TextBlur="0.3" FontSize="50" TextColorFactor="0.8"/>
			<Style Name="Disabled" FontColor="#E2AF54FF" TextGlowColor="#000000FF" TextOutlineColor="#000000FF" TextOutlineAmount="0.1" TextGlowRadius="0.3" TextBlur="0.3" FontSize="50" TextColorFactor="1" TextAlphaFactor="1"/>
		</Styles>
	</Brush>
</Brushes>
