<?xml version="1.0" encoding="utf-8"?>
<RCMConfig>
  <!--=== MODULE TOGGLES ===-->
  <ArmorSystemEnabled>false</ArmorSystemEnabled>
  <HitboxSystemEnabled>true</HitboxSystemEnabled>
  <PenetrationSystemEnabled>true</PenetrationSystemEnabled>
  <WeaponDamageSystemEnabled>true</WeaponDamageSystemEnabled>
  <DebugMode>false</DebugMode>
  <!--Show RCM armor classification in inventory tooltips (material, layers, protection rating).-->
  <TooltipSystemEnabled>true</TooltipSystemEnabled>
  <!--Handle/pommel hits (swinging with shaft or grip instead of the blade) deal reduced blunt damage. Set false to disable. default: true-->
  <HandleHitEnabled>true</HandleHitEnabled>
  <SkillScalingEnabled>true</SkillScalingEnabled>
  <!--=== ARMOR BASE VALUES (inherent material protection, 0-100 scale) ===-->
  <ArmorBaseValues>
    <Cloth>8</Cloth>
    <!--default: 8-->
    <Gambeson>22</Gambeson>
    <!--default: 22-->
    <Leather>15</Leather>
    <!--default: 15-->
    <LeatherPadded>25</LeatherPadded>
    <!--default: 25-->
    <Mail>25</Mail>
    <!--default: 25-->
    <MailPadded>38</MailPadded>
    <!--default: 38-->
    <Scale>38</Scale>
    <!--default: 38-->
    <Lamellar>40</Lamellar>
    <!--default: 40-->
    <PlateThin>38</PlateThin>
    <!--default: 38-->
    <PlateMedium>53</PlateMedium>
    <!--default: 53-->
    <PlateThick>83</PlateThick>
    <!--default: 83-->
  </ArmorBaseValues>
  <!--Show subtle hit location messages during combat (Face, Neck, Armpit). Only for player hits.-->
  <CombatFeedbackEnabled>true</CombatFeedbackEnabled>
  <!--=== DAMAGE VS MATERIAL (% of damage that passes through, 0.0-1.0) ===-->
  <!--Lower = better protection. Based on historical effectiveness.-->
  <DamageVsMaterial>
    <!--Cut: swords/axes. Mail near-immune, plate immune.-->
    <CutVsCloth>0.85</CutVsCloth>
    <CutVsLeather>0.6</CutVsLeather>
    <CutVsMail>0.15</CutVsMail>
    <CutVsLamellar>0.12</CutVsLamellar>
    <CutVsPlate>0.05</CutVsPlate>
    <!--Pierce: thrusts/arrows. Can find gaps in mail.-->
    <PierceVsCloth>0.9</PierceVsCloth>
    <PierceVsLeather>0.7</PierceVsLeather>
    <PierceVsMail>0.55</PierceVsMail>
    <PierceVsLamellar>0.35</PierceVsLamellar>
    <PierceVsPlate>0.15</PierceVsPlate>
    <!--Blunt: maces/hammers. Transfers shock through rigid armor.-->
    <BluntVsCloth>0.9</BluntVsCloth>
    <BluntVsLeather>0.85</BluntVsLeather>
    <BluntVsMail>0.8</BluntVsMail>
    <!--Same as above but for body/limb hits. Higher = torso armor absorbs impact; heavy concussion is reserved for head/neck.-->
    <BluntArmorEffectivenessBody>1</BluntArmorEffectivenessBody>
    <BluntVsLamellar>0.7</BluntVsLamellar>
    <BluntVsPlate>0.55</BluntVsPlate>
  </DamageVsMaterial>
  <!--How effective armor is against blunt (0 = blunt ignores armor, 1 = same as cut/pierce). Lower = heavy weapons concuss through plate.-->
  <BluntArmorEffectiveness>0.4</BluntArmorEffectiveness>
  <!--=== BLUNT TRAUMA: min % of attack that always passes as impact ===-->
  <BluntTraumaPercent>0.12</BluntTraumaPercent>
  <!--=== CONCUSSIVE TRAUMA BY WEAPON (multiplies BluntTraumaPercent for cut/pierce stopped by armor) ===-->
  <ConcussiveFactors>
    <Dagger>0.5</Dagger>
    <Sword>1</Sword>
    <Polearm>1.1</Polearm>
    <OneHandedAxe>1.9</OneHandedAxe>
    <TwoHandedAxe>3</TwoHandedAxe>
    <SwingPolearm>2.3</SwingPolearm>
    <Mace>2</Mace>
    <TwoHandedMace>3.2</TwoHandedMace>
    <Default>1</Default>
    <ThrowingAxe>3</ThrowingAxe>
    <ThrowingKnife>0.5</ThrowingKnife>
    <Stone>4</Stone>
    <SlingStone>6.5</SlingStone>
    <MissileBluntPenFloor>0.85</MissileBluntPenFloor>
    <WeightCoefficient>0.15</WeightCoefficient>
  </ConcussiveFactors>
  <!--=== COVERAGE MULTIPLIERS ===-->
  <CoverageDefaults>
    <DefaultLeg>0.6</DefaultLeg>
    <LongLeg>0.8</LongLeg>
    <ShortLeg>0.2</ShortLeg>
    <DefaultArm>0.7</DefaultArm>
    <FullArm>0.9</FullArm>
    <ShortSleeveArm>0.4</ShortSleeveArm>
    <SleevelessArm>0.2</SleevelessArm>
  </CoverageDefaults>
  <!--=== ARROW PENETRATION ===-->
  <Penetration>
    <BaseThreshold>20</BaseThreshold>
    <ArrowMultiplier>1</ArrowMultiplier>
    <BoltMultiplier>1.3</BoltMultiplier>
    <JavelinMultiplier>1.3</JavelinMultiplier>
    <KEReference>7</KEReference>
    <MinMult>0.15</MinMult>
    <MaxMult>2.5</MaxMult>
    <CuttingMaxMult>1</CuttingMaxMult>
  </Penetration>
  <!--=== ITEM QUALITY MODIFIERS (Rusty/Reinforced/Lordly scale armor) ===-->
  <ItemModifiers>
    <MinMult>0.7</MinMult>
    <MaxMult>1.3</MaxMult>
  </ItemModifiers>
  <!--=== SKILL SCALING (trained warriors hit harder; multiplies attack power) ===-->
  <SkillScaling>
    <MinMult>0.85</MinMult>
    <MaxMult>1.25</MaxMult>
    <Reference>200</Reference>
  </SkillScaling>
  <!--=== KEYWORD BONUS VALUES (additive, added to base armor) ===-->
  <KeywordBonuses>
    <Quality>5</Quality>
    <MailLayer>25</MailLayer>
    <Padding>4</Padding>
    <Fur>3</Fur>
    <Double>8</Double>
    <BadPenalty>-4</BadPenalty>
  </KeywordBonuses>
  <!--Face weak-point: how directly the hit surface must face forward (0-1). Lower = detects more face hits.-->
  <FaceShotThreshold>0.3</FaceShotThreshold>
  <!--Open-helmet face exposure curve. Higher = closed helmets stay safer, only very open helmets expose face.-->
  <FaceExposureExponent>2</FaceExposureExponent>
  <ArmorVariationRange>2</ArmorVariationRange>
  <!--=== CONCUSSIVE STAGGER (visual flinch on armored head hits, no damage) ===-->
  <!--When a head/neck hit deals 0-threshold damage but had enough force, the agent flinches.-->
  <ConcussiveStagger>
    <Enabled>true</Enabled>
    <!--Only trigger stagger when inflicted damage is at or below this value.-->
    <DamageThreshold>3</DamageThreshold>
    <!--Minimum BaseMagnitude (engine impact force) to trigger. Higher = only hard hits stagger.-->
    <ShockThreshold>5</ShockThreshold>
    <!--Seconds before same agent can be staggered again. Prevents stagger-lock.-->
    <Cooldown>1.5</Cooldown>
    <!--Animation speed multiplier. Higher = faster/lighter flinch. 1.0 = full dramatic stagger.-->
    <AnimSpeed>1.3</AnimSpeed>
  </ConcussiveStagger>
  <!--=== WEAPON BOUNCE ON ARMOR (cut/thrust deflection off rigid metal) ===-->
  <!--When cut/pierce damage is at or below threshold vs plate/scale/lamellar, weapon bounces.-->
  <!--Blunt weapons (maces, hammers) and picks NEVER bounce.-->
  <WeaponBounce>
    <Enabled>true</Enabled>
    <!--Max damage for cut to still bounce. Higher = more bounces. default: 3-->
    <CutMaxDamage>3</CutMaxDamage>
    <!--Max damage for pierce to still bounce. Lower than cut because thrusts are harder to deflect. default: 2-->
    <PierceMaxDamage>2</PierceMaxDamage>
    <!--Threshold multiplier for axes. 0.3 = axes only bounce at near-zero damage. default: 0.3-->
    <AxeMultiplier>0.3</AxeMultiplier>
  </WeaponBounce>
  <!--=== MELEE THRUST BOOST ===-->
  <!--Multiplier for melee thrust weaponFactor. Spears have low ThrustDamageFactor in engine data, making thrusts weak. 1.0 = no change, 1.5 = 50% stronger thrusts. Does NOT affect missiles (arrows/bolts/javelins).-->
  <MeleeThrustBoost>2.3</MeleeThrustBoost>
  <!--Thrust boost for face shots against helmets with face protection. Lower = nasal/visor protects more. 1.0 = no boost (default).-->
  <FaceThrustBoost>1.3</FaceThrustBoost>
  <!--How much of the thrust boost applies vs Plate armor (0.0 = no boost vs plate, 1.0 = full boost). Scale/Lamellar keep full boost (they have gaps). default: 0.25-->
  <ThrustBoostPlateReduction>0.25</ThrustBoostPlateReduction>
  <RangedFaceBoost>1.3</RangedFaceBoost>
  <!--=== REALISTIC SHIELD HITBOX (missile collision) ===-->
  <!--Vanilla shields have an invisible collision body larger than the visual shield that catches arrows. true = shrink it to the shield model so volleys can go around a shield or through gaps in a shieldwall. The vanilla shield perk still adds its small bonus on top.-->
  <RealisticShieldHitbox>true</RealisticShieldHitbox>
  <!--=== CAVALRY CHARGE (momentum trample damage; feeds into material system as Blunt) ===-->
  <!--Vanilla charge damage is 1-15. This multiplies the engine magnitude so charges are historically devastating.-->
  <CavalryCharge>
    <Enabled>true</Enabled>
    <!--Base magnitude multiplier for all cavalry charges. Higher = deadlier. default: 3.5-->
    <BaseMult>3.5</BaseMult>
    <!--Extra multiplier when horse has barding (armored = heavier = more momentum). default: 1.3-->
    <BardingMult>1.3</BardingMult>
    <!--Minimum ChargeVelocity to trigger knockback. Vanilla requires 0.7 alignment instead. Lower = easier knockback. default: 1.5-->
    <KnockbackMinSpeed>1.5</KnockbackMinSpeed>
  </CavalryCharge>
  <!--=== SHIELD BASH & PUNCH (realistic bash/fist damage through material system) ===-->
  <!--Shield bashes and punches are processed as Blunt through the material pipeline instead of vanilla.-->
  <ShieldBashAndPunch>
    <ShieldBashEnabled>true</ShieldBashEnabled>
    <!--Magnitude multiplier for shield bashes. Higher = deadlier. default: 2.5-->
    <ShieldBashMult>35</ShieldBashMult>
    <!--Reference shield weight in kg. Shields heavier than this hit harder, lighter hit softer. default: 5.0-->
    <ShieldBashWeightRef>5</ShieldBashWeightRef>
    <PunchEnabled>true</PunchEnabled>
    <!--Bare fist magnitude multiplier. default: 1.2-->
    <PunchBaseMult>1.3</PunchBaseMult>
    <!--Max magnitude multiplier with best gauntlets. Scales linearly from BaseMult to this. default: 3.0-->
    <PunchGauntletMaxMult>6</PunchGauntletMaxMult>
    <!--Gauntlet armor value at which you get the full GauntletMaxMult bonus. default: 40-->
    <PunchGauntletArmorRef>40</PunchGauntletArmorRef>
    <!--Controlled bonus for Basher perk on shield bashes. Vanilla +50% is OP with RCM. 1.0 = no bonus, 1.15 = +15%. default: 1.0-->
    <BasherPerkMult>1</BasherPerkMult>
    <KickEnabled>true</KickEnabled>
    <!--Kick damage multiplier with bare feet / cloth boots. default: 1.0-->
    <KickBaseMult>1</KickBaseMult>
    <!--Kick damage multiplier with leather boots. default: 1.3-->
    <KickLeatherMult>1.3</KickLeatherMult>
    <!--Kick damage multiplier with mail sabatons. default: 1.5-->
    <KickMailMult>1.5</KickMailMult>
    <!--Kick damage multiplier with plate sabatons. Steel toe to the gut. default: 2.0-->
    <KickPlateMult>2</KickPlateMult>
    <WeaponBashEnabled>true</WeaponBashEnabled>
    <!--Pommel/butt strike multiplier for swords, axes, maces. Pommel = concentrated steel knob. default: 2.0-->
    <PommelStrikeMult>20</PommelStrikeMult>
    <!--Shaft bash multiplier for polearms/spears. Just a shove with a stick. default: 0.8-->
    <ShaftBashMult>5</ShaftBashMult>
    <BluntKnockoutEnabled>true</BluntKnockoutEnabled>
    <!--Minimum inflicted damage for knockout roll. Below this = no chance. default: 15-->
    <KnockoutMinDamage>15</KnockoutMinDamage>
    <!--Knockout probability = (damage / victimMaxHP) × this value. Higher = more knockouts. default: 1.5-->
    <KnockoutChanceScale>1.5</KnockoutChanceScale>
    <!--Maximum knockout probability cap (0.0-1.0). default: 0.5 (50%)-->
    <KnockoutMaxChance>0.5</KnockoutMaxChance>
  </ShieldBashAndPunch>
</RCMConfig>